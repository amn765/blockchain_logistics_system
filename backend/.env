# ---------------------------------
# 服务器与数据库配置
# ---------------------------------

# Node.js 服务器运行的端口
PORT=3001

# 你的 MongoDB 连接字符串
# 如果在本地运行:
MONGODB_URI=mongodb://127.0.0.1:27017/supplychain
# 如果使用云服务 (如 MongoDB Atlas)，请粘贴你的连接字符串

# ---------------------------------
# 认证配置
# ---------------------------------

# 用于签名 JWT 的密钥。请替换为一个长且随机的字符串
JWT_SECRET=ZJU_2025Fall_SupplyChain_SecretKey
JWT_EXPIRE=24h

# ---------------------------------
# Hyperledger Fabric 配置
# ---------------------------------

# 从 backend 目录到 blockchain 目录的相对路径
FABRIC_NETWORK_PATH=../blockchain

# 通道名称 (在 server.js 中定义为 'supplychainchannel')
FABRIC_CHANNEL=supplychainchannel

# 链码名称 (在 server.js 中定义为 'supplychain')
FABRIC_CHAINCODE=supplychain

# 后端服务器连接时使用的组织 (在 server.js 中定义为 'manufacturer')
FABRIC_ORG=manufacturer

# 后端服务器连接时使用的 Fabric 用户身份 (在 server.js 中定义为 'appUser')
FABRIC_USER=appUser